.streamlit/secrets.toml

# Logs
*.log

# Database files (if using local SQLite)
*.db
*.sqlite
*.sqlite3

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# pytest cache
.pytest_cache/

# Coverage reports
htmlcov/
.coverage
.coverage.*

# MyPy type checker
.mypy_cache/
.dmypy.json
dmypy.json
