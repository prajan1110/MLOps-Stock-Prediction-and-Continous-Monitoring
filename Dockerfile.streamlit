FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
    STREAMLIT_SERVER_PORT=8501

WORKDIR /app

COPY requirements-dashboard.txt ./requirements-dashboard.txt
RUN python -m pip install --no-cache-dir --retries 10 --timeout 300 -r requirements-dashboard.txt
COPY requirements-dashboard-ui.txt ./requirements-dashboard-ui.txt
RUN python -m pip install --no-cache-dir --retries 10 --timeout 300 -r requirements-dashboard-ui.txt

COPY frontend.py backend_data.py backend_main.py backend_model.py ./
COPY src ./src
COPY monitoring ./monitoring
COPY assets ./assets

EXPOSE 8501

CMD ["streamlit", "run", "frontend.py"]
